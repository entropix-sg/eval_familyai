# syntax=docker/dockerfile:1
# 基础镜像：registry.example.com/testing/android-emulator-base:api35-v1
FROM ubuntu:24.04

ARG TARGETARCH
ARG CMDLINE_TOOLS_VERSION=15859902
ARG CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG SYSTEM_IMAGE=system-images;android-35;google_apis;x86_64

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    LANG=C.UTF-8 \
    TZ=Asia/Shanghai
ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/emulator:${PATH}

RUN test "${TARGETARCH:-amd64}" = amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl unzip openjdk-21-jre-headless tini procps \
       libasound2t64 libpulse0 libnss3 libx11-6 libxcb1 libxcomposite1 \
       libxcursor1 libxi6 libxrandr2 libxrender1 libxtst6 libxkbcommon0 \
       libxkbcommon-x11-0 libdbus-1-3 libfontconfig1 libfreetype6 \
       libgl1 libegl1 libvulkan1 libstdc++6 e2fsprogs \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && curl --fail --location --retry 3 \
       "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_TOOLS_VERSION}_latest.zip" \
       -o /tmp/cmdline-tools.zip \
    && echo "${CMDLINE_TOOLS_SHA256}  /tmp/cmdline-tools.zip" | sha256sum -c - \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/android-tools \
    && mv /tmp/android-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -rf /tmp/cmdline-tools.zip /tmp/android-tools

# 接受 SDK 许可；构建此镜像的组织应已确认可接受相应许可。
RUN yes | sdkmanager --sdk_root="${ANDROID_HOME}" --licenses >/dev/null \
    && sdkmanager --sdk_root="${ANDROID_HOME}" \
       "platform-tools" "emulator" "${SYSTEM_IMAGE}" \
    && printf '%s\n' "${SYSTEM_IMAGE}" > /opt/android-system-image \
    && sdkmanager --sdk_root="${ANDROID_HOME}" --list_installed > /opt/android-sdk-packages.txt \
    && image_dir="$(printf '%s' "${SYSTEM_IMAGE}" | tr ';' '/')" \
    && sha256sum "${ANDROID_HOME}/${image_dir}/source.properties" \
       "${ANDROID_HOME}/emulator/source.properties" > /opt/android-image-identity \
    && rm -rf /root/.android/cache

WORKDIR /opt/emulator
